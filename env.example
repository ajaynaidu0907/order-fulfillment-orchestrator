# ---------------------------------------------------------------------------
# Order Fulfillment Orchestrator - example configuration.
# Copy to .env for local runs:  cp env.example .env
# These are SYNTHETIC dev-only values.
# NEVER put real credentials in this file or commit a populated .env.
# ---------------------------------------------------------------------------

# Runtime environment: development | staging | production
OFO_ENV=development

# HTTP API
OFO_HTTP_ADDR=:8080
OFO_HTTP_READ_TIMEOUT=15s
OFO_HTTP_WRITE_TIMEOUT=15s
OFO_HTTP_SHUTDOWN_TIMEOUT=20s

# PostgreSQL (system of record)
OFO_DB_HOST=postgres
OFO_DB_PORT=5432
OFO_DB_USER=ofo
OFO_DB_PASSWORD=ofo_dev_password_change_me
OFO_DB_NAME=ofo
OFO_DB_SSLMODE=disable
OFO_DB_MAX_CONNS=20
OFO_DB_MIN_CONNS=2

# Redis (cache, rate limiting, short-lived locks)
OFO_REDIS_ADDR=redis:6379
OFO_REDIS_PASSWORD=
OFO_REDIS_DB=0

# Background worker
OFO_WORKER_CONCURRENCY=4
OFO_WORKER_POLL_INTERVAL=1s
OFO_WORKER_CLAIM_BATCH=10
OFO_WORKER_LOCK_TTL=30s
OFO_WORKER_REAP_INTERVAL=15s

# Observability
OFO_OTEL_ENABLED=true
OFO_OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4318
OFO_OTEL_SERVICE_NAME=order-fulfillment-orchestrator
OFO_METRICS_ADDR=:9090
OFO_LOG_LEVEL=info

# Simulated failure rates for mock domain services (0.0 - 1.0), for demos/tests.
OFO_SIM_PAYMENT_DECLINE_RATE=0.0
OFO_SIM_FULFILLMENT_FAILURE_RATE=0.0
